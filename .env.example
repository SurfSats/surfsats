# Alby Wallet API access token (Vercel: ALBY_ACCESS_TOKEN)
# Never commit the real value.
ALBY_ACCESS_TOKEN=

# Optional Svix signing secret from the Alby webhook endpoint
# ALBY_WEBHOOK_SECRET=

# Optional override. Default: https://api.getalby.com
# ALBY_API_BASE=

# Neon (or any Postgres) connection string. Required for a shared public wall.
# Use the pooled Neon URL in Vercel: DATABASE_URL
DATABASE_URL=
